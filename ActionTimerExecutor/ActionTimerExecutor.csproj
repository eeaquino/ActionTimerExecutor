<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>ActionTimer</PackageId>
		<Version>1.3.0</Version>
		<Authors>Edgar Aquino</Authors>
		<Company>edgaraquino.dev</Company>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<EnablePackageValidation>true</EnablePackageValidation>
		<RollForward>latestFeature</RollForward>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Creates a PeriodicTimer that can execute Func&lt;Task&gt; Items in descending order of interval requested or concurrent. </Description>
		<PackageProjectUrl>https://github.com/eeaquino/ActionTimerExecutor</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<AssemblyVersion>1.3.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- .NET 11 only: opt into the runtime async engine (no compiler-generated state machine). -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<Features>runtime-async=on</Features>
	</PropertyGroup>

	<ItemGroup>
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
	</ItemGroup>

</Project>
